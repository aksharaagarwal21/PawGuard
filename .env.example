# PawGuard 360 environment variables. Copy to `.env` (never commit `.env`).
# For local development, `uv run python scripts/dev_env.py` writes a complete `.env` from the running
# local Supabase stack and generates random passwords for the runtime database roles.

# --- General -----------------------------------------------------------------------------------------
# development | test | staging | production
PAWGUARD_ENV=development
# Demo mode: DEMO banner, demo tenant and seeded-account sign-in shortcuts. Refused when ENV=production.
PAWGUARD_DEMO_MODE=true
PAWGUARD_LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------------------------------
# Passwords for the runtime roles created by migration 0001 (NOBYPASSRLS, not table owners).
PAWGUARD_DB_API_PASSWORD=change-me-api
PAWGUARD_DB_WORKER_PASSWORD=change-me-worker
# Request-path connection: MUST use the pawguard_api role, never the owner.
PAWGUARD_DATABASE_URL=postgresql://pawguard_api:change-me-api@127.0.0.1:54322/postgres
# Worker connection (pawguard_worker role).
PAWGUARD_WORKER_DATABASE_URL=postgresql://pawguard_worker:change-me-worker@127.0.0.1:54322/postgres
# Owner connection for Alembic and the admin CLI only.
PAWGUARD_MIGRATE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Separate database used by the automated test suite (created by `pawguard-admin create-test-db`).
PAWGUARD_TEST_DATABASE_NAME=pawguard_test

# --- Supabase (Auth + Storage) -----------------------------------------------------------------------
# URL the API/worker use to reach Supabase.
PAWGUARD_SUPABASE_URL=http://127.0.0.1:54321
# URL browsers use for signed upload/download URLs (differs from the above inside Docker networks).
PAWGUARD_SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
# Server-only secret key (sb_secret_...). Used for Storage signing and admin user provisioning.
# NEVER expose to the browser or the web bundle.
PAWGUARD_SUPABASE_SECRET_KEY=
PAWGUARD_STORAGE_BUCKET=pawguard-media
# Optional overrides; default to <SUPABASE_URL>/auth/v1 and its JWKS endpoint.
# PAWGUARD_AUTH_ISSUER=
# PAWGUARD_AUTH_JWKS_URL=
PAWGUARD_AUTH_AUDIENCE=authenticated

# --- Jobs --------------------------------------------------------------------------------------------
PAWGUARD_REDIS_URL=redis://127.0.0.1:6379/0

# --- Web (Next.js server; none of these are NEXT_PUBLIC_) ---------------------------------------------
# Where the Next.js server reaches FastAPI.
PAWGUARD_API_INTERNAL_URL=http://127.0.0.1:8000
# Public origin of the web app (CSRF/origin checks, redirects).
PAWGUARD_WEB_ORIGIN=http://localhost:3000
# Extra origins the app is also served from, comma-separated (set by scripts/public_link.sh for a temporary tunnel)
PAWGUARD_EXTRA_WEB_ORIGINS=
# true: browsers get same-origin storage links, forwarded by the web app (needed behind a public tunnel)
PAWGUARD_STORAGE_SAME_ORIGIN=false
# Timezone used to display dates on public pages (IANA name).
PAWGUARD_DEFAULT_TIMEZONE=Asia/Kolkata
# Publishable key used ONLY by server-side Supabase Auth calls (sign-in, refresh). Not sent to browsers.
PAWGUARD_SUPABASE_PUBLISHABLE_KEY=

# --- Optional providers (features stay visibly unavailable when unset) --------------------------------
# Map tiles: development may use OSM standard tiles (light interactive use, attribution required).
# Production must configure a provider whose terms permit the expected usage.
PAWGUARD_MAP_TILE_URL=
PAWGUARD_MAP_TILE_ATTRIBUTION=
# Phase 10 (optional): server-side Claude API key for cited explanations. Leave empty to keep generation off.
# PAWGUARD_ANTHROPIC_API_KEY=

# --- Free notification and AI providers (see docs/FREE_SERVICES_SETUP.md) ----------------------------------
# Never commit real values. Demo mode sends every message to the test recipients below, never to the fictional
# @example.org demo addresses.
PAWGUARD_DEMO_NOTIFY_EMAIL=
PAWGUARD_DEMO_NOTIFY_WHATSAPP=
# Email: Gmail SMTP with an app password (or Brevo SMTP). Empty password = email off.
PAWGUARD_SMTP_HOST=smtp.gmail.com
PAWGUARD_SMTP_PORT=587
PAWGUARD_SMTP_USER=
PAWGUARD_SMTP_PASSWORD=
PAWGUARD_EMAIL_FROM=
# Stay well under Gmail's 500/day; extra messages wait for the next day.
PAWGUARD_EMAIL_DAILY_CAP=100
# Web Push (VAPID). Keys are generated by `pawguard-admin push keys`; the contact is a mailto: address.
PAWGUARD_VAPID_PUBLIC_KEY=
PAWGUARD_VAPID_PRIVATE_KEY=
PAWGUARD_VAPID_CONTACT=
# WhatsApp Cloud API test number. The temporary token expires in under 24 hours.
PAWGUARD_WHATSAPP_TOKEN=
PAWGUARD_WHATSAPP_PHONE_NUMBER_ID=
PAWGUARD_WHATSAPP_APP_SECRET=
PAWGUARD_WHATSAPP_VERIFY_TOKEN=
PAWGUARD_WHATSAPP_TEMPLATE=
# AI assistant: gemini | ollama | off. Free-tier Gemini prompts may be reviewed by Google: no personal data.
PAWGUARD_LLM_PROVIDER=off
PAWGUARD_GEMINI_API_KEY=
# Copy a model code that shows free quota on https://aistudio.google.com/rate-limit (e.g. a Flash or Flash-Lite model).
PAWGUARD_GEMINI_MODEL=
PAWGUARD_OLLAMA_URL=http://127.0.0.1:11434
PAWGUARD_OLLAMA_MODEL=qwen2.5:3b
