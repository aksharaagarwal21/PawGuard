# Dependencies and build output
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
coverage/
playwright-report/
test-results/
blob-report/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
